{
  "manifest_version": 3,
  "name": "ApplyPilot Application Assistant",
  "version": "3.2.0",
  "description": "Fills approved answers and attaches each job's own resume. Submits only applications you approved in ApplyPilot and stops for anything that needs you.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://job-boards.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://applypilot-hub.amused-bream-5718.chatgpt.site/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": { "default_title": "ApplyPilot Application Assistant", "default_popup": "popup.html" }
}
